/*
 * The default theme's layout: the LCDD baseline — htmx, the latest Bootstrap CSS, and the default theme's
 * own stylesheet (`asset('theme.css')`). It carries no application branding and no helpers beyond
 * laminas-view's own, so a component or application theme can replace it without inheriting anything.
 */

$this->headMeta()
    ->setCharSet('UTF-8')
    ->appendName('viewport', 'width=device-width, initial-scale=1')
    ->appendName('color-scheme', 'light dark');

$this->headLink()
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    ->appendStylesheet($this->basePath($this->asset('theme.css')));

$this->headScript()
    ->appendFile('https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js');

$this->inlineScript()
    ->prependFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    ->appendScript(<<<'JS'
        htmx.onLoad((root) => {
            root.querySelectorAll('.toast').forEach((toast) => bootstrap.Toast.getOrCreateInstance(toast).show());
        });
        JS);
?>

<?= $this->doctype(); ?>

<html lang="en" data-bs-theme="light">
    <head>
        <base href="<?= $this->basePath('/'); ?>" />
        <?= $this->headTitle('webware')->setSeparator(' | ') ?>
        <?= $this->headMeta() ?>
        <?= $this->headLink() ?>
        <?= $this->headScript() ?>
    </head>
    <body hx-boost="true" hx-push-url="true" hx-target="main">
        <main id="app">
            <?= $this->body ?>
        </main>
        <?= $this->inlineScript() ?>
    </body>
</html>
