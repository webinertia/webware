/*
 * The default theme's layout: the LCDD baseline - htmx, the latest Bootstrap CSS, and the default theme's
 * own stylesheet (`asset('theme.css')`). It carries no application branding and no helpers beyond
 * laminas-view's own, so a component or application theme can replace it without inheriting anything.
 */

$this->headMeta()
    ->setCharSet('UTF-8')
    ->appendName('viewport', 'width=device-width, initial-scale=1')
    ->appendName('color-scheme', 'light dark');

$this->headLink(
    [
        'rel'  => 'icon',
        'type' => 'image/svg+xml',
        'href' => $this->basePath('favicon.svg'),
    ],
);

$this->headLink()
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    ->appendStylesheet($this->basePath($this->asset('theme.css')));

$this->headScript()
    ->appendFile('https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js')
    // Dark is the default; a stored choice wins. Runs in the head so the page never flashes light.
    ->appendScript(<<<'JS'
        try {
            document.documentElement.dataset.bsTheme = localStorage.getItem('webware-theme') || 'dark';
        } catch (e) {}
        JS);

$this->inlineScript()
    ->prependFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    ->appendFile($this->basePath($this->asset('messenger.js')))
    ->appendFile($this->basePath($this->asset('app.js')));
?>

<?= $this->doctype(); ?>

<html lang="en" data-bs-theme="dark">
    <head>
        <base href="<?= $this->basePath('/'); ?>" />
        <?= $this->headTitle('webware')->setSeparator(' | ') ?>
        <?= $this->headMeta() ?>
        <?= $this->headLink() ?>
        <?= $this->headScript() ?>
    </head>
    <body hx-boost="true" hx-push-url="true" hx-target="main">
        <main id="app" class="d-flex flex-column min-vh-100">
            <?= $this->body ?>
        </main>
        <div class="modal fade" id="sharedModal" tabindex="-1" aria-hidden="true">
            <div id="sharedModalDialog"></div>
        </div>
        <div id="systemMessage" class="toast-container position-fixed bottom-0 end-0 p-4" aria-live="polite" aria-atomic="false"></div>
        <template id="toastTemplate">
            <div class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body toast-message"></div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </template>
        <?= $this->inlineScript() ?>
    </body>
</html>
